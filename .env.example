# Copy this file to .env and fill in your values

# Ollama model to use for inference (must be present on OLLAMA_MODELS_PATH)
# Examples: llama3.2:3b  llama3.1:8b  mistral:7b  phi3:mini
OLLAMA_MODEL=llama3.2:3b

# Host path to your Ollama model store (mounted read-only into the container)
# macOS/Linux default: ~/.ollama/models
OLLAMA_MODELS_PATH=~/.ollama/models

# Host path for the shared job volume
# The container reads  $SHARED_VOLUME_PATH_HOST/<job_id>/transcript.txt
# and writes           $SHARED_VOLUME_PATH_HOST/<job_id>/output.json
SHARED_VOLUME_PATH_HOST=/tmp/ai4me_shared

# Optional: maximum transcript length in characters (0 = no limit)
MAX_TRANSCRIPT_CHARS=0

# Optional: Uvicorn tuning (keep workers=1 for CPU-only; scale horizontally instead)
UVICORN_WORKERS=1
UVICORN_LOG_LEVEL=info
